# ==============================================================
# CivicLoop Environment Configuration Template
# Duplicate this file to .env and customize values
# ==============================================================

# Server Port
PORT=3000

# Application Environment Mode (development | production | test)
NODE_ENV=development

# Municipal Field Worker Secret Credential
# Protects PATCH /api/reports/:id/status administrative workflows
WORKER_SECRET=civicloop-field-worker-2026

# Default Citizen Identifier Context
DEFAULT_USER_ID=CITIZEN-CURRENT

# (Optional) Future Gemini LLM Vision API Integration
# GEMINI_API_KEY=your_gemini_api_key_here
